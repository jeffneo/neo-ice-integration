# Copy to .env and adjust. The test suite and Spark jobs read these values.
# `docker compose` also auto-loads .env for variable substitution in the compose file.

# ---------------------------------------------------------------------------
# Neo4j connection.
# ---------------------------------------------------------------------------
# DEFAULT: Neo4j runs in Docker as part of this stack (compose service "neo4j").
#   NEO4J_URI      = how the Spark container reaches it (docker network name)
#   NEO4J_URI_HOST = how the host-side pytest driver reaches it (localhost)
NEO4J_URI=bolt://neo4j:7687
NEO4J_URI_HOST=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password12345
NEO4J_DATABASE=neo4j
#
# To use an EXTERNAL Neo4j instead (Aura or any non-Docker instance), set BOTH
# URIs to the same reachable URI (and don't start the neo4j container):
#   NEO4J_URI=neo4j+s://<your-db-id>.databases.neo4j.io
#   NEO4J_URI_HOST=neo4j+s://<your-db-id>.databases.neo4j.io

# ---------------------------------------------------------------------------
# Object store credentials for MinIO (Iceberg's S3 backend). Test defaults are fine.
# ---------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=admin
AWS_SECRET_ACCESS_KEY=password
AWS_REGION=us-east-1

# ---------------------------------------------------------------------------
# Iceberg catalog wiring (matches docker-compose service names).
# ---------------------------------------------------------------------------
ICEBERG_CATALOG=iceberg
ICEBERG_REST_URI=http://iceberg-rest:8181
ICEBERG_WAREHOUSE=s3://warehouse/
ICEBERG_S3_ENDPOINT=http://minio:9000
ICEBERG_NAMESPACE=movies

# Neo4j Spark Connector coordinate (Scala 2.12 / Spark 3.x).
NEO4J_SPARK_CONNECTOR=org.neo4j:neo4j-connector-apache-spark_2.12:5.3.1_for_spark_3
