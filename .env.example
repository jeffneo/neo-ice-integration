# Copy to .env and adjust. The test suite and Spark jobs read these values.
# `docker compose` also auto-loads .env for variable substitution in the compose file.

# ---------------------------------------------------------------------------
# Neo4j connection (configurable, per the requirement).
# ---------------------------------------------------------------------------
# Pick ONE of the following URI styles:
#
#   Local Neo4j started via `--profile local-neo4j`, reached FROM the Spark
#   container (same docker network) -> use the service name:
NEO4J_URI=bolt://neo4j:7687
#
#   Neo4j running on your host (Docker Desktop) but NOT in this compose file,
#   reached from the Spark container:
# NEO4J_URI=bolt://host.docker.internal:7687
#
#   Neo4j Aura or any external instance:
# NEO4J_URI=neo4j+s://<your-db-id>.databases.neo4j.io

NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password12345

# Neo4j database to use (Neo4j 4.0+ multi-db). Leave as "neo4j" for defaults.
NEO4J_DATABASE=neo4j

# ONLY needed when Neo4j is the dockerized-local one (`--profile local-neo4j`):
# the Spark container reaches it as `bolt://neo4j:7687` (NEO4J_URI above) but the
# host-side pytest driver must use localhost. For Aura / any external instance,
# leave this unset — the host driver reuses NEO4J_URI.
# NEO4J_URI_HOST=bolt://localhost:7687

# ---------------------------------------------------------------------------
# Object store credentials for MinIO (Iceberg's S3 backend). Test defaults are fine.
# ---------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=admin
AWS_SECRET_ACCESS_KEY=password
AWS_REGION=us-east-1

# ---------------------------------------------------------------------------
# Iceberg catalog wiring (matches docker-compose service names).
# ---------------------------------------------------------------------------
ICEBERG_CATALOG=iceberg
ICEBERG_REST_URI=http://iceberg-rest:8181
ICEBERG_WAREHOUSE=s3://warehouse/
ICEBERG_S3_ENDPOINT=http://minio:9000
ICEBERG_NAMESPACE=movies

# Neo4j Spark Connector coordinate (Scala 2.12 / Spark 3.x).
NEO4J_SPARK_CONNECTOR=org.neo4j:neo4j-connector-apache-spark_2.12:5.3.1_for_spark_3
